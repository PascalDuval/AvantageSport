# ─────────────────────────────────────────────────────────────────
# .env.example — Copiez ce fichier en .env et remplissez vos valeurs
# Le fichier .env ne doit JAMAIS être versionné (voir .gitignore)
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poc_sport
DB_USER=admin
DB_PASSWORD=admin123

# ── pgAdmin ───────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@poc.local
PGADMIN_PASSWORD=admin123

# ── Paramètres métier ─────────────────────────────────────────────
TAUX_PRIME=0.05
SEUIL_MARCHE_KM=15.0
SEUIL_VELO_KM=25.0
MIN_ACTIVITES_BE=15
NB_JOURS_BE=5
ADRESSE_BUREAU=1362 Av. des Platanes, 34970 Lattes

# ── Générateur Strava-like ────────────────────────────────────────
STRAVA_MONTHS_BACK=12
STRAVA_MIN_ACTS=2
STRAVA_MAX_ACTS=5
STRAVA_COMMENT_RATE=0.20

# ── APIs externes (Round 2+) ──────────────────────────────────────
# GOOGLE_MAPS_API_KEY=your_key_here
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
GOOGLE_MAPS_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GMAPS_MOCK_MODE=false
SLACK_WEBHOOK_URL=your_slack_webhook_url_here        # canal #social (performances)
SLACK_ALERT_WEBHOOK_URL=your_slack_alert_webhook_url_here  # canal #alerting (erreurs pipeline)
