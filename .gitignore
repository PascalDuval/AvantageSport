# ─────────────────────────────────────────────────────────────────
# .gitignore — POC Avantages Sportifs
# ─────────────────────────────────────────────────────────────────

# ── Secrets & config locaux ───────────────────────────────────────
.env
*.key

# ── Claude Code (config personnelle de l'IDE) ─────────────────────
.claude/

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ── Environnements virtuels ───────────────────────────────────────
.venv/
venv/
env/
.conda/

# ── Données brutes (données personnelles RH — ne jamais versionner) ──
data/raw/*
!data/raw/.gitkeep

# ── Delta Lake local (re-générable, potentiellement très volumineux) ──
data/delta/*
!data/delta/.gitkeep

# ── Logs locaux (re-générables) ───────────────────────────────────
logs/*
!logs/.gitkeep

# ── Rapports générés (re-générables) ─────────────────────────────
reports/*
!reports/.gitkeep

# ── Fichiers de données dans docus (données personnelles) ─────────
docus/*


# ── Tests & couverture ────────────────────────────────────────────
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/
coverage.xml

# ── IDE ───────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker volumes (pas dans le repo) ────────────────────────────
docker/volumes/

# ── Jupyter ───────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Great Expectations (secrets et résultats locaux) ─────────────
great_expectations/uncommitted/

# ── Documents de cadrage (usage interne uniquement) ───────────────
notedecadrage.txt
